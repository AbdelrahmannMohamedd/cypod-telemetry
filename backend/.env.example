# cypod-telemetry backend config -- copy this file to .env and adjust as needed.

PORT=4000

# PostgreSQL connection string. If you installed Postgres locally with the default
# superuser, this is usually correct as-is other than the database name.
DATABASE_URL=postgres://postgres:kandil96@localhost:5432/cypod_telemetry

# Secret used to sign JWTs. Change this to any long random string for real use --
# the value below is only a placeholder for local development.
JWT_SECRET=change-this-dev-secret
JWT_EXPIRES_IN=2h

# Alert thresholds (see README "Caching" and "Alerts" sections)
TEMP_CEILING_C=45
BATTERY_FLOOR_PCT=15
